{
  "version": 7,
  "cmakeMinimumRequired": {
    "major": 3
  },
  "configurePresets": [
    {
      "name": "flexspi_nor_sdram_debug",
      "displayName": "flexspi_nor_sdram_debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/${presetName}",
      "toolchainFile": "$env{SdkRootDirPath}/tools/cmake_toolchain_files/armgcc.cmake",
      "inherits": "flexspi_nor_sdram_debug-env",
      "cacheVariables": {
        "POSTPROCESS_UTILITY": "$env{POSTPROCESS_UTILITY}",
